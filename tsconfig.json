{
    "compilerOptions": {

        "target": "ES2023",

        "module": "ESNext",

        "moduleResolution": "Bundler",

        "strict": true,

        "allowJs": false,

        "jsx": "react-jsx",

        "jsxImportSource": "ags",

        "esModuleInterop": true,

        "resolveJsonModule": true,

        "skipLibCheck": true,

        "isolatedModules": true,

        "forceConsistentCasingInFileNames": true

    },

    "include": [

        "shell/**/*",

        "tools/**/*"

    ]
}
